  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.1.0",
    "@fontsource-variable/inter": "5.1.0",
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "sharp": "0.33.5",
    "vite": "5.4.11"
  }
}
